{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        // Effect 4.1 marks the HTTP server and client, the CLI, RPC middleware,
        // FileSystem, Path, and the Node runtime unstable. This board is built
        // on those modules, and effect@4.1.2 has no stable replacement.
        "allowedUnstableApis": [
          "effect/http",
          "effect/http-api",
          "effect/cli",
          "effect/rpc",
          "effect/FileSystem",
          "effect/Path",
          "@effect/platform-node"
        ]
      }
    ]
  },
  "include": [
    "alchemy.run.ts",
    "e2e.config.ts",
    "scripts/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/web/vite.config.ts",
    "tests/**/*.ts"
  ]
}
