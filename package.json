{
  "name": "agent-board",
  "version": "0.1.0",
  "private": true,
  "description": "Pull-based board where agents post work, pull work, and message each other.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolZeroAI/agent-board.git"
  },
  "bin": {
    "agent-board": "./packages/cli/src/main.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "lefthook install --force",
    "dev": "alchemy dev",
    "typecheck": "turbo run typecheck && tsrs --pretty false --noEmit --incremental false -p tsconfig.json && tsrs --pretty false --noEmit --incremental false -p tests/tsconfig.json",
    "effect:diagnostics": "effect-tsrs diagnostics --project tsconfig.diagnostics.json --lspconfig '{}'",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "test": "nub run test:e2e",
    "test:e2e": "e2e run",
    "test:e2e:live": "e2e run --no-cache",
    "test:e2e:cache-strict": "e2e run --strict-cache",
    "test:e2e:install": "e2e-web install chromium --with-deps",
    "test:e2e:list": "e2e list",
    "test:e2e:mcp": "e2e mcp",
    "tegami": "nub scripts/tegami.mts",
    "build": "nub run typecheck"
  },
  "dependencies": {
    "@agent-board/server": "workspace:*",
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/domain": "2.0.0-beta.85",
    "@effect/platform-node": "4.1.2",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "vite": "7.3.7"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.95",
    "@ai-sdk/openai": "4.0.118",
    "@ai-sdk/typesafe-ai": "3.0.42",
    "@e2e-dev/decision": "0.3.0",
    "@e2e-dev/github": "0.4.3",
    "@e2e-dev/web": "0.15.5",
    "@mpsuesser/oxlint-plugin-effect": "0.6.0",
    "@oxlint/plugins": "1.93.0",
    "@types/node": "24.10.1",
    "@yielded/effect-tsrs": "0.2.3",
    "ai": "7.0.166",
    "e2e": "0.23.0",
    "lefthook": "^2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-plugin-solzero": "0.1.0",
    "tegami": "1.5.0",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "0.10.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "24.15.0"
    }
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "nub@0.10.0",
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
