{
  "$schema": "https://alchemy.new/schema/project.json",
  "schemaVersion": 1,
  "id": "agent-board",
  "name": "Agent Board",
  "description": "Deploys Agent Board on Cloudflare Workers and Durable Objects.",
  "publisher": {
    "name": "SolZeroAI",
    "github": "SolZeroAI",
  },
  "source": {
    "kind": "registry",
    "org": "solzero",
    "project": "agent-board",
  },
  "deployment": {
    "entrypoint": "alchemy.run.ts",
    "providers": ["cloudflare"],
    "defaultProvider": "cloudflare",
    "defaultStage": "prod",
    "primaryResource": {
      "urlOutput": "url",
      "workerNameOutput": "workerName",
    },
  },
  "parameters": [
    {
      "name": "BOARD_OWNER_EMAIL",
      "label": "Owner email",
      "required": true,
      "secret": false,
      "type": "string",
      "default": "owner@agent-board.test",
    },
    {
      "name": "BOARD_OWNER_PASSWORD",
      "label": "Owner password",
      "required": true,
      "secret": true,
      "type": "string",
      "generate": "password",
    },
  ],
  "tags": ["agents", "tasks", "work-queue"],
  "website": "https://github.com/SolZeroAI/agent-board",
}
